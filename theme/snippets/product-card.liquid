{% comment %}
  ABOUTME: Product card component for grids and collections
  ABOUTME: Form-like styling with SKU labels and requisition buttons
{% endcomment %}

<article class="product-card">
  <a href="{{ product.url }}" class="product-card-inner">
    <div class="product-image">
      {% if product.compare_at_price > product.price %}
        <span class="product-badge">Budget Surplus</span>
      {% elsif product.available == false %}
        <span class="product-badge product-badge--sold-out">Requisition Closed</span>
      {% elsif product.tags contains 'new' %}
        <span class="product-badge product-badge--new">New</span>
      {% endif %}

      {% if product.featured_image != blank %}
        <img
          src="{{ product.featured_image | image_url: width: 400 }}"
          alt="{{ product.featured_image.alt | default: product.title }}"
          width="400"
          height="500"
          loading="lazy"
        >
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card-placeholder' }}
      {% endif %}
    </div>

    <div class="product-info">
      <span class="product-sku">SKU: {{ product.variants.first.sku | default: product.id }}</span>
      <h3 class="product-title">{{ product.title }}</h3>

      {% if product.description != blank %}
        <p class="product-description">{{ product.description | strip_html | truncate: 80 }}</p>
      {% endif %}

      <div class="product-footer">
        <span class="product-price">
          {% if product.compare_at_price > product.price %}
            <span class="product-price-original">{{ product.compare_at_price | money }}</span>
          {% endif %}
          {{ product.price | money }}
        </span>
        <span class="product-action">Requisition</span>
      </div>
    </div>
  </a>
</article>

{% style %}
  .product-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: var(--transition-normal);
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 4px 4px 0 var(--color-border);
  }

  .product-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .product-image {
    aspect-ratio: 4/5;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .product-image img,
  .product-image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition-normal);
  }

  .product-card:hover .product-image img {
    transform: scale(1.03);
  }

  .product-badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    font-family: var(--font-accent);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-accent);
    color: var(--color-surface);
    z-index: 1;
  }

  .product-badge--sold-out {
    background-color: var(--color-text-muted);
  }

  .product-badge--new {
    background-color: var(--color-primary);
  }

  .product-info {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-sku {
    font-family: var(--font-accent);
    font-size: 0.625rem;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  .product-title {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .product-description {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: auto;
    padding-bottom: var(--space-md);
  }

  .product-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .product-price {
    font-family: var(--font-accent);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .product-price-original {
    text-decoration: line-through;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    margin-right: var(--space-xs);
  }

  .product-action {
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border-dark);
    transition: var(--transition-fast);
  }

  .product-card:hover .product-action {
    background-color: var(--color-primary);
    color: var(--color-surface);
  }

  .product-card-placeholder {
    background-color: var(--color-background);
  }
{% endstyle %}
