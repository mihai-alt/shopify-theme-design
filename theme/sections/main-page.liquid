{% comment %}
  ABOUTME: Standard page template for static content
  ABOUTME: Form-like styling consistent with theme DNA
{% endcomment %}

<section class="page-section">
  <div class="container">
    <header class="page-header">
      <p class="page-meta">Document | Internal Reference</p>
      <h1 class="page-title">{{ page.title | upcase }}</h1>
    </header>

    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% style %}
  .page-section {
    padding: var(--space-xl) 0 var(--space-2xl);
  }

  .page-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border-dark);
  }

  .page-meta {
    font-family: var(--font-accent);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .page-content {
    max-width: 800px;
  }

  .page-content h2,
  .page-content h3,
  .page-content h4 {
    font-family: var(--font-heading);
    text-transform: uppercase;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .page-content p {
    margin-bottom: var(--space-md);
    line-height: 1.7;
  }

  .page-content ul,
  .page-content ol {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .page-content li {
    margin-bottom: var(--space-xs);
  }

  .page-content a {
    color: var(--color-accent);
    text-decoration: underline;
  }
{% endstyle %}

{% schema %}
{
  "name": "Page Content",
  "class": "section-page"
}
{% endschema %}
