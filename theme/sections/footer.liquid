{% comment %}
  ABOUTME: Site footer with brand info, navigation columns, and legal links
  ABOUTME: Dark background with corporate memo styling
{% endcomment %}

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-logo">{{ section.settings.brand_name | default: shop.name }}</p>
        <p class="footer-tagline">
          {{ section.settings.tagline }}
          {% if section.settings.show_redacted %}
            <span class="redacted">{{ section.settings.redacted_text }}</span>
          {% endif %}
        </p>
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu' %}
            <div class="footer-column" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              <nav class="footer-links">
                {% for link in block.settings.menu.links %}
                  <a href="{{ link.url }}" class="footer-link">{{ link.title }}</a>
                {% endfor %}
              </nav>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
      <div class="footer-legal">
        {% if section.settings.show_brands %}
          <span>Dropbox</span>
          <span>GitHub</span>
          <span>tickd</span>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% style %}
  .site-footer {
    background-color: var(--color-primary);
    color: var(--color-surface);
    padding: var(--space-2xl) 0 var(--space-lg);
    border-top: 4px solid var(--color-accent);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-secondary);
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .footer-column h4 {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-link {
    font-family: var(--font-accent);
    font-size: 0.8125rem;
    color: var(--color-surface);
    opacity: 0.8;
    transition: var(--transition-fast);
    text-decoration: none;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-accent);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .footer-legal {
    display: flex;
    gap: var(--space-lg);
  }

  .footer-bottom .redacted {
    background-color: var(--color-surface);
    color: var(--color-surface);
  }

  .footer-bottom .redacted:hover {
    background-color: transparent;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "MANDATORY FUN"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Official merchandise distribution center. Your participation has been noted and appreciated."
    },
    {
      "type": "checkbox",
      "id": "show_redacted",
      "label": "Show redacted text",
      "default": true
    },
    {
      "type": "text",
      "id": "redacted_text",
      "label": "Redacted text",
      "default": "Compliance rate: 94%"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "A Division of Definitely Real Corp."
    },
    {
      "type": "checkbox",
      "id": "show_brands",
      "label": "Show brand names",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "NAVIGATION"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "NAVIGATION"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "INFORMATION"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "POLICY"
          }
        }
      ]
    }
  ]
}
{% endschema %}
