{% comment %}
  ABOUTME: Featured collection section displaying products in a grid
  ABOUTME: Form 27-B styled with SKU labels and requisition buttons
{% endcomment %}

<section class="section-products">
  <div class="container">
    <div class="section-header">
      <div class="section-title-group">
        {% if section.settings.form_number != blank %}
          <p class="section-label">{{ section.settings.form_number }}</p>
        {% endif %}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {% if section.settings.description != blank %}
          <p class="section-description">{{ section.settings.description }}</p>
        {% endif %}
      </div>
      {% if section.settings.button_text != blank %}
        {% assign collection_url = section.settings.button_link | default: section.settings.collection.url | default: routes.all_products_collection_url %}
        <a href="{{ collection_url }}" class="btn btn-secondary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <div class="product-grid product-grid--{{ section.settings.products_per_row }}">
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          {% render 'product-card-placeholder' %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .section-products {
    padding: var(--space-2xl) 0;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .section-title-group {
    max-width: 500px;
  }

  .section-label {
    font-family: var(--font-accent);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
  }

  .section-description {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .product-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .product-grid--4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .product-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 1024px) {
    .product-grid--4,
    .product-grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }

    .product-grid--4,
    .product-grid--3 {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .product-grid--4,
    .product-grid--3 {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Featured Collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "form_number",
      "label": "Form number label",
      "default": "Form 27-B: Featured Inventory"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "APPROVED FOR DISTRIBUTION"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The following items have been cleared by Human Resources for employee acquisition. Selection is final."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "products_per_row",
      "label": "Products per row",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View Full Catalog"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to collection URL if left blank"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
